*.pyo
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/

# Tip kontrolü & lint cache
.mypy_cache/
.ruff_cache/
.pytype/

# Test & kapsam
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
