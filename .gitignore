*.db
*.sqlite
*.sqlite3

# Celery zamanlayıcı durumu
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid
*.pid

# ── Ortam değişkenleri (ASLA commit edilmez) ──────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.test
backend/.env
frontend-web/.env.local

