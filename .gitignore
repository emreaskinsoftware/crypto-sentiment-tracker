node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build cache
*.tsbuildinfo

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/

# ── Flutter / Dart ────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

