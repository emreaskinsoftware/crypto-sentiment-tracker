# Veritabanı
# Lokal geliştirme:
DATABASE_URL=postgresql://postgres:crypto123@localhost:5433/crypto_sentiment
# Docker içinde bu satır docker-compose.yml tarafından otomatik override edilir.

# JWT
JWT_SECRET=degistir-cok-gizli-bir-anahtar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS (virgülle ayrılmış origin listesi)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Celery + Redis
# Lokal geliştirme:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Docker içinde bu satırlar docker-compose.yml tarafından otomatik override edilir.

# SMTP E-posta (isteğe bağlı)
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ornek@gmail.com
SMTP_PASSWORD=gmail-uygulama-sifresi
SMTP_FROM_EMAIL=ornek@gmail.com

# Firebase Cloud Messaging (isteğe bağlı)
FCM_ENABLED=False
FCM_CREDENTIALS_JSON={"type":"service_account",...}
